// Middleware de surveillance et d'alerte globale
app.use((req, res, next) => {
    const ip = req.headers['x-forwarded-for'] || req.socket.remoteAddress;
    const url = req.url;
    const userAgent = req.headers['user-agent'] || 'Inconnu';

    // Signatures d'attaques courantes (Injections SQL, XSS, Directory Traversal)
    const patternsMalveillants = [
        /(\bunion\b.*\bselect\b)/i, // Injection SQL
        /<script\b[^<]*(?:(?!<\/script>)<[^<]*)*<\/script>/i, // XSS
        /\.\.\/\.\.\//, // Directory traversal (vol de fichiers système)
        /(\bexec\b|\bshell\b|\bcmd\b)/i // Tentative d'exécution de commande
    ];

    const contenuRequete = JSON.stringify(req.body) + url + JSON.stringify(req.query);

    for (let pattern of patternsMalveillants) {
        if (pattern.test(contenuRequete)) {
            envoyerAlerteSecurite({
                type: 'Attaque par Injection ou XSS',
                ip: ip,
                url: url,
                userAgent: userAgent,
                payload: contenuRequete
            });

            // Bloquer immédiatement la requête
            return res.status(403.4).json({ erreur: "Accès refusé. Activité suspecte détectée." });
        }
    }

    next();
});

